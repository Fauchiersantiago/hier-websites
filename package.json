{
  "name": "hier-auto-websites",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "astro:check": "astro check",
    "build": "pnpm run validate:previews && astro build && pnpm run verify:build",
    "check": "pnpm run typecheck && pnpm run astro:check && pnpm run test && pnpm run schemas:check && pnpm run build && pnpm run test:browser",
    "dev": "astro dev",
    "preview": "astro preview",
    "schemas:check": "pnpm run schemas:generate && git diff --exit-code -- schemas/generated",
    "schemas:generate": "tsx scripts/generate-json-schemas.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:demo": "tsx scripts/validate-site.ts sites/demo-nails",
    "validate:previews": "tsx scripts/validate-site.ts sites/demo-nails && tsx scripts/validate-site.ts sites/demo-restaurant",
    "verify:build": "tsx scripts/verify-build.ts"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "axe-core": "4.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
