{
  "name": "hier-auto-websites",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test && pnpm run schemas:check",
    "schemas:check": "pnpm run schemas:generate && git diff --exit-code -- schemas/generated",
    "schemas:generate": "tsx scripts/generate-json-schemas.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:demo": "tsx scripts/validate-site.ts sites/demo-nails"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
