{
  "$id": "https://hier.example/schemas/hero-compact-banner-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sectionId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "businessType": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "tagline": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "headline": {
      "type": "string",
      "minLength": 10,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 280
    },
    "cta": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "href": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false
    },
    "phone": {
      "type": "object",
      "properties": {
        "display": {
          "type": "string",
          "minLength": 8,
          "maxLength": 30
        },
        "href": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^tel:.*"
        }
      },
      "required": [
        "display",
        "href"
      ],
      "additionalProperties": false
    },
    "alignment": {
      "default": "start",
      "type": "string",
      "enum": [
        "start",
        "center"
      ]
    }
  },
  "required": [
    "businessType",
    "tagline",
    "headline",
    "description",
    "cta",
    "phone",
    "alignment"
  ],
  "additionalProperties": false
}
