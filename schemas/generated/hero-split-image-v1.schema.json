{
  "$id": "https://hier.example/schemas/hero-split-image-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sectionId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "businessType": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "tagline": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "headline": {
      "type": "string",
      "minLength": 10,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 280
    },
    "cta": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "href": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "alt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 180
        },
        "focalPoint": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "src",
        "alt",
        "focalPoint"
      ],
      "additionalProperties": false
    },
    "imagePosition": {
      "default": "end",
      "type": "string",
      "enum": [
        "start",
        "end"
      ]
    }
  },
  "required": [
    "businessType",
    "tagline",
    "headline",
    "description",
    "cta",
    "image",
    "imagePosition"
  ],
  "additionalProperties": false
}
