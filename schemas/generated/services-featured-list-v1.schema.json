{
  "$id": "https://hier.example/schemas/services-featured-list-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "services": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 70
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240
          },
          "attributes": {
            "default": [],
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "attributes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "services"
  ],
  "additionalProperties": false
}
