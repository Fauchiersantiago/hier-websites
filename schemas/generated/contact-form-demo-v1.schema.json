{
  "$id": "https://hier.example/schemas/contact-form-demo-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 90
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 240
    },
    "responseTime": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100
    },
    "privacyNote": {
      "type": "string",
      "minLength": 15,
      "maxLength": 220
    },
    "services": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 70
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "eyebrow",
    "title",
    "description",
    "responseTime",
    "privacyNote",
    "services"
  ],
  "additionalProperties": false
}
