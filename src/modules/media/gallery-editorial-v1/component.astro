---
import type { GalleryModuleProps } from "../../../renderer/module-definitions";

type Props = GalleryModuleProps;

const { eyebrow, title, description, items } = Astro.props;
---

<section id="galeria" data-module-id="gallery-editorial-v1" aria-label={eyebrow} class="overflow-hidden py-[var(--space-section)]">
  <div class="page-container">
    <header class="max-w-3xl border-b border-line pb-10">
      <h2 class="section-heading display-balance max-w-[11ch]">{title}</h2>
      <p class="copy-pretty mt-7 max-w-xl text-base leading-7 text-muted lg:text-lg lg:leading-8">
        {description}
      </p>
    </header>

    <div class="gallery-grid mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-12 lg:grid-rows-2">
      {items.map((item, index) => (
        <figure
          class:list={[
            "gallery-card group grid min-h-0 grid-rows-[1fr_auto] overflow-hidden bg-surface",
            index === 0
              ? "sm:col-span-2 lg:col-span-7 lg:row-span-2"
              : "lg:col-span-5",
          ]}
        >
          <div class="min-h-0 overflow-hidden">
            <img
              src={item.src}
              alt={item.alt}
              width={index === 0 ? "1672" : "1122"}
              height={index === 0 ? "941" : "1402"}
              loading="lazy"
              decoding="async"
              style={`object-position:${item.focalPoint.x}% ${item.focalPoint.y}%`}
              class:list={[
                "h-full w-full object-cover",
                index === 0 ? "aspect-[4/3] lg:aspect-auto" : "aspect-[4/5] lg:aspect-auto",
              ]}
            />
          </div>
          <figcaption class="px-5 py-4 text-sm font-semibold leading-6 text-ink">
            {item.caption}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
