---
import type { GalleryModuleProps } from "../../../renderer/module-definitions";

type Props = GalleryModuleProps;

const { eyebrow, title, description, items } = Astro.props;
---

<section id="galeria" data-module-id="gallery-editorial-v1" class="overflow-hidden py-[var(--space-section)]">
  <div class="page-container">
    <div class="grid gap-8 border-b border-line pb-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div>
        <p class="eyebrow text-accent">{eyebrow}</p>
        <h2 class="section-heading display-balance mt-6 max-w-[11ch]">{title}</h2>
      </div>
      <p class="copy-pretty max-w-xl text-base leading-7 text-muted lg:justify-self-end lg:text-lg lg:leading-8">
        {description}
      </p>
    </div>

    <div class="gallery-grid mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-12 lg:grid-rows-2">
      {items.map((item, index) => (
        <figure
          class:list={[
            "gallery-card group relative overflow-hidden bg-surface",
            index === 0
              ? "sm:col-span-2 lg:col-span-7 lg:row-span-2"
              : "lg:col-span-5",
          ]}
        >
          <img
            src={item.src}
            alt={item.alt}
            width={index === 0 ? "1672" : "1122"}
            height={index === 0 ? "941" : "1402"}
            loading="lazy"
            decoding="async"
            style={`object-position:${item.focalPoint.x}% ${item.focalPoint.y}%`}
            class:list={[
              "h-full w-full object-cover",
              index === 0 ? "aspect-[4/3] lg:aspect-auto" : "aspect-[4/5] lg:aspect-auto",
            ]}
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-media-scrim/75 via-media-scrim/20 to-transparent px-5 pb-5 pt-16 text-on-media">
            <figcaption class="font-label text-xs font-semibold uppercase tracking-[0.14em]">
              {item.caption}
            </figcaption>
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>
