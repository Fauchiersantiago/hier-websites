---
import type { ServicesModuleProps } from "../../../renderer/module-definitions";

type Props = ServicesModuleProps;

const { services } = Astro.props;
---

<section id="servicios" data-module-id="services-grid-v1" class="border-y border-line bg-surface/55 py-[var(--space-section)]">
  <div class="page-container">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="lg:sticky lg:top-10 lg:self-start">
        <p class="eyebrow text-accent">La selección</p>
        <h2 class="display-balance mt-6 max-w-[8ch] font-display text-5xl leading-[0.95] tracking-[-0.045em] sm:text-7xl">
          Servicios
        </h2>
        <p class="mt-7 text-sm font-semibold text-muted">{services.length} opciones disponibles</p>
      </div>

      <ol class="border-t border-line">
        {services.map((service, index) => (
          <li class="group grid gap-5 border-b border-line py-9 sm:grid-cols-[4rem_1fr] sm:py-11">
            <span class="font-display text-2xl italic text-accent/70" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-display text-3xl tracking-[-0.025em] transition-transform duration-300 group-hover:translate-x-1 sm:text-4xl">
                {service.name}
              </h3>
              <p class="copy-pretty mt-4 max-w-2xl leading-7 text-muted">{service.description}</p>
              {service.attributes.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Características de ${service.name}`}>
                  {service.attributes.map((attribute) => (
                    <li class="rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-muted">
                      {attribute}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
