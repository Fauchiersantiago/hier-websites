---
import type { FooterModuleProps } from "../../../renderer/module-definitions";

type Props = FooterModuleProps;

const { businessName, businessType, address, phone, email, hours, conceptNotice } = Astro.props;
---

<footer data-module-id="footer-basic-v1" class="bg-inverse-surface py-16 text-on-inverse sm:py-20">
  <div class="page-container">
    <div class="grid gap-12 border-b border-inverse-line pb-14 lg:grid-cols-[1.25fr_0.75fr_0.75fr]">
      <div>
        <p class="brand-mark text-4xl sm:text-5xl">{businessName}</p>
        <p class="mt-4 max-w-sm text-sm leading-6 text-on-inverse-muted">{businessType}</p>
      </div>

      <div>
        <h2 class="font-label text-sm font-semibold text-on-inverse-muted">Visítanos</h2>
        <address class="mt-5 text-sm not-italic leading-6 text-on-inverse">{address}</address>
        <div class="mt-3 flex flex-col items-start text-sm">
          <a class="touch-link underline decoration-inverse-line underline-offset-4 hover:decoration-on-inverse" href={phone.href}>{phone.display}</a>
          <a class="touch-link underline decoration-inverse-line underline-offset-4 hover:decoration-on-inverse" href={`mailto:${email}`}>{email}</a>
        </div>
      </div>

      <div>
        <h2 class="font-label text-sm font-semibold text-on-inverse-muted">Horario</h2>
        <dl class="mt-5 space-y-2 text-xs text-on-inverse-muted">
          {hours.map((entry) => (
            <div class="flex justify-between gap-5">
              <dt>{entry.day}</dt>
              <dd class="text-right text-on-inverse">{entry.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="mt-7 flex flex-col gap-3 text-xs leading-5 text-on-inverse-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {businessName}</p>
      <p class="max-w-2xl sm:text-right" data-concept-notice>{conceptNotice}</p>
    </div>
  </div>
</footer>
