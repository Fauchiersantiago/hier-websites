---
import ButtonLink from "../../../primitives/button-link.astro";
import type { HeroModuleProps } from "../../../renderer/module-definitions";

type Props = HeroModuleProps;

const { sectionId = "inicio", businessType, tagline, headline, description, cta, image, imagePosition = "end" } = Astro.props;
---

<section id={sectionId} data-module-id="hero-split-image-v1" class="hero-module overflow-hidden py-[var(--space-section)]">
  <div class="hero-layout page-container grid items-center gap-14 lg:grid-cols-[1.04fr_0.96fr] lg:gap-20">
    <div class:list={["hero-copy relative z-10", imagePosition === "start" && "lg:order-2"]}>
      <p class="hero-kicker eyebrow reveal text-accent" data-section-eyebrow>{businessType}</p>
      <h1
        class="hero-heading display-balance reveal reveal-delay-1 mt-7"
      >
        {headline}
      </h1>
      <p class="hero-description copy-pretty reveal reveal-delay-2 mt-8 max-w-xl text-lg leading-8 text-muted sm:text-xl">
        {description}
      </p>
      <div class="hero-actions reveal reveal-delay-3 mt-10 flex flex-wrap items-center gap-5">
        <ButtonLink href={cta.href} label={cta.label} />
      </div>
    </div>

    <figure class:list={["hero-figure reveal reveal-delay-2 relative mx-auto w-full max-w-[38rem]", imagePosition === "start" ? "lg:order-1 lg:ml-0" : "lg:mr-0"]}>
      <div class="hero-orb absolute -left-6 top-10 z-10 hidden h-28 w-28 rounded-full bg-signal md:block"></div>
      <div class="hero-ring absolute -right-10 -top-10 h-44 w-44 rounded-full border border-accent/35"></div>
      <div class="hero-image-shell image-reveal">
        <img
          data-builder-photo
          src={image.src}
          alt={image.alt}
          width="1200"
          height="900"
          class="hero-image"
          style={`object-position:${image.focalPoint.x}% ${image.focalPoint.y}%`}
          fetchpriority="high"
        />
      </div>
      <figcaption class="copy-pretty mt-5 max-w-md px-1 text-sm font-semibold leading-6 text-muted">
        {tagline}
      </figcaption>
    </figure>
  </div>
</section>
