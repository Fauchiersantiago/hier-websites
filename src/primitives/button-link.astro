---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "inverse" | "quiet";
}

const { href, label, variant = "primary" } = Astro.props;
---

<a
  href={href}
  class:list={[
    "button-link inline-flex items-center justify-center",
    `button-link--${variant}`,
  ]}
>
  <span>{label}</span>
</a>
