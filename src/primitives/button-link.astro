---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "inverse" | "quiet";
}

const { href, label, variant = "primary" } = Astro.props;

const variants = {
  primary:
    "bg-accent text-on-accent hover:bg-accent-strong border-accent shadow-[0_0.75rem_2rem_rgb(84_34_55_/_0.18)]",
  inverse:
    "bg-signal text-ink hover:bg-surface border-signal shadow-[0_0.75rem_2rem_rgb(0_0_0_/_0.18)]",
  quiet: "bg-transparent text-ink hover:bg-surface border-line",
};
---

<a
  href={href}
  class:list={[
    "inline-flex min-h-12 items-center justify-center rounded-full border px-6 py-3 text-sm font-semibold transition-[background-color,color,border-color,transform] duration-200 ease-out hover:-translate-y-0.5",
    variants[variant],
  ]}
>
  {label}
</a>
