---
import { resolve } from "node:path";

import { restaurantAssetUrls } from "../../sites/demo-restaurant/assets";
import BaseLayout from "../layouts/base-layout.astro";
import { loadSiteBundle } from "../lib/site-bundle";
import SiteRenderer from "../renderer/site-renderer.astro";

const bundle = await loadSiteBundle(resolve("sites/demo-restaurant"));
---

<BaseLayout
  title={`${bundle.site.identity.businessName} | Concepto`}
  description={bundle.site.content.description}
  themeId={bundle.site.presentation.themeId}
  noindex={bundle.site.preview.noindex}
>
  <SiteRenderer bundle={bundle} assetUrls={restaurantAssetUrls} />
</BaseLayout>
